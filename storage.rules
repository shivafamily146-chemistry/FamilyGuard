rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /cameraSnapshots/{childUid}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == childUid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && firestore.get(/databases/(default)/documents/familyLinks/$(childUid)).data.childUid == childUid;
      allow read: if request.auth != null
        && (request.auth.uid == childUid
          || firestore.get(/databases/(default)/documents/familyLinks/$(childUid)).data.parentUid == request.auth.uid);
    }
  }
}