rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function pairedChild(childUid) {
      return firestore.get(/databases/(default)/documents/familyLinks/$(childUid)).data.childUid == childUid;
    }
    function pairedParent(childUid) {
      return firestore.get(/databases/(default)/documents/familyLinks/$(childUid)).data.parentUid == request.auth.uid;
    }
    match /cameraSnapshots/{childUid}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == childUid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && pairedChild(childUid);
      allow read: if request.auth != null
        && (request.auth.uid == childUid || pairedParent(childUid));
    }
    match /audioMessages/{childUid}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == childUid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'audio/mp4'
        && pairedChild(childUid);
      allow read: if request.auth != null
        && (request.auth.uid == childUid || pairedParent(childUid));
    }
    match /screenSnapshots/{childUid}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == childUid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && pairedChild(childUid);
      allow read: if request.auth != null
        && (request.auth.uid == childUid || pairedParent(childUid));
    }
  }
}