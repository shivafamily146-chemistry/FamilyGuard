rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  match /pairCodes/{code}{
   allow create: if signedIn() && request.resource.data.parentUid == request.auth.uid;
   allow get: if signedIn(); allow list: if false;
   allow update: if signedIn() && ((resource.data.parentUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consumedBy'])) || (resource.data.consumedBy == '' && request.resource.data.consumedBy == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consumedBy'])));
   allow delete: if signedIn() && resource.data.parentUid == request.auth.uid;
  }
  match /familyLinks/{childUid}{
   allow create: if signedIn() && childUid == request.auth.uid && request.resource.data.childUid == request.auth.uid && exists(/databases/$(database)/documents/pairCodes/$(request.resource.data.pairCode)) && get(/databases/$(database)/documents/pairCodes/$(request.resource.data.pairCode)).data.parentUid == request.resource.data.parentUid && get(/databases/$(database)/documents/pairCodes/$(request.resource.data.pairCode)).data.consumedBy == request.auth.uid;
   allow read: if signedIn() && (resource.data.childUid == request.auth.uid || resource.data.parentUid == request.auth.uid);
   allow update,delete: if false;
  }
  match /approvalRequests/{id}{
   allow create: if signedIn() && request.resource.data.childUid == request.auth.uid && request.resource.data.status == 'pending' && exists(/databases/$(database)/documents/familyLinks/$(request.auth.uid)) && get(/databases/$(database)/documents/familyLinks/$(request.auth.uid)).data.parentUid == request.resource.data.parentUid;
   allow read: if signedIn() && (resource.data.childUid == request.auth.uid || resource.data.parentUid == request.auth.uid);
   allow update: if signedIn() && resource.data.parentUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedAt']) && request.resource.data.status in ['approved','denied'];
   allow delete: if false;
  }
  match /locations/{childUid}{
   allow create,update: if signedIn() && request.auth.uid == childUid && request.resource.data.childUid == childUid && exists(/databases/$(database)/documents/familyLinks/$(childUid)) && get(/databases/$(database)/documents/familyLinks/$(childUid)).data.parentUid == request.resource.data.parentUid;
   allow read: if signedIn() && (request.auth.uid == childUid || (exists(/databases/$(database)/documents/familyLinks/$(childUid)) && get(/databases/$(database)/documents/familyLinks/$(childUid)).data.parentUid == request.auth.uid));
   allow delete: if false;
  }
  match /locationHistory/{entryId}{
   allow create: if signedIn() && request.resource.data.childUid == request.auth.uid && exists(/databases/$(database)/documents/familyLinks/$(request.auth.uid)) && get(/databases/$(database)/documents/familyLinks/$(request.auth.uid)).data.parentUid == request.resource.data.parentUid;
   allow read: if signedIn() && (resource.data.childUid == request.auth.uid || resource.data.parentUid == request.auth.uid);
   allow update,delete: if false;
  }
  match /appBlockRules/{ruleId}{
   allow create: if signedIn() && request.resource.data.parentUid == request.auth.uid && request.resource.data.active == true && request.resource.data.packageName is string && request.resource.data.packageName.size() > 2 && exists(/databases/$(database)/documents/familyLinks/$(request.resource.data.childUid)) && get(/databases/$(database)/documents/familyLinks/$(request.resource.data.childUid)).data.parentUid == request.auth.uid;
   allow read: if signedIn() && (resource.data.parentUid == request.auth.uid || resource.data.childUid == request.auth.uid);
   allow update,delete: if signedIn() && resource.data.parentUid == request.auth.uid;
  }
  match /screenTimeLimits/{ruleId}{
   allow create: if signedIn() && request.resource.data.parentUid == request.auth.uid && request.resource.data.active == true && request.resource.data.packageName is string && request.resource.data.dailyLimitMinutes is int && request.resource.data.dailyLimitMinutes >= 1 && request.resource.data.dailyLimitMinutes <= 1440 && exists(/databases/$(database)/documents/familyLinks/$(request.resource.data.childUid)) && get(/databases/$(database)/documents/familyLinks/$(request.resource.data.childUid)).data.parentUid == request.auth.uid;
   allow read: if signedIn() && (resource.data.parentUid == request.auth.uid || resource.data.childUid == request.auth.uid);
   allow update: if signedIn() && resource.data.parentUid == request.auth.uid && request.resource.data.parentUid == request.auth.uid && request.resource.data.childUid == resource.data.childUid && request.resource.data.packageName == resource.data.packageName && request.resource.data.dailyLimitMinutes is int && request.resource.data.dailyLimitMinutes >= 1 && request.resource.data.dailyLimitMinutes <= 1440;
   allow delete: if signedIn() && resource.data.parentUid == request.auth.uid;
  }
  match /websiteBlockRules/{ruleId}{
   allow create: if signedIn() && request.resource.data.parentUid == request.auth.uid && request.resource.data.active == true && request.resource.data.domain is string && request.resource.data.domain.size() >= 4 && exists(/databases/$(database)/documents/familyLinks/$(request.resource.data.childUid)) && get(/databases/$(database)/documents/familyLinks/$(request.resource.data.childUid)).data.parentUid == request.auth.uid;
   allow read: if signedIn() && (resource.data.parentUid == request.auth.uid || resource.data.childUid == request.auth.uid);
   allow update,delete: if signedIn() && resource.data.parentUid == request.auth.uid;
  }
  match /browserDomainEvents/{eventId}{
   allow create: if signedIn() && request.resource.data.childUid == request.auth.uid && request.resource.data.domain is string && request.resource.data.blocked is bool && exists(/databases/$(database)/documents/familyLinks/$(request.auth.uid)) && get(/databases/$(database)/documents/familyLinks/$(request.auth.uid)).data.parentUid == request.resource.data.parentUid;
   allow read: if signedIn() && (resource.data.childUid == request.auth.uid || resource.data.parentUid == request.auth.uid);
   allow update,delete: if false;
  }
  match /cameraSnapshots/{snapshotId}{
   allow create: if signedIn() && request.resource.data.childUid == request.auth.uid && request.resource.data.parentUid == get(/databases/$(database)/documents/familyLinks/$(request.auth.uid)).data.parentUid && request.resource.data.captureType == 'child_initiated_camera_thumbnail';
   allow read: if signedIn() && (resource.data.childUid == request.auth.uid || resource.data.parentUid == request.auth.uid);
   allow update,delete: if false;
  }
  match /audioMessages/{messageId}{
   allow create: if signedIn() && request.resource.data.childUid == request.auth.uid && exists(/databases/$(database)/documents/familyLinks/$(request.auth.uid)) && request.resource.data.parentUid == get(/databases/$(database)/documents/familyLinks/$(request.auth.uid)).data.parentUid && request.resource.data.captureType == 'child_initiated_audio_recording';
   allow read: if signedIn() && (resource.data.childUid == request.auth.uid || resource.data.parentUid == request.auth.uid);
   allow update,delete: if false;
  }
  match /screenSnapshots/{snapshotId}{
   allow create: if signedIn() && request.resource.data.childUid == request.auth.uid && exists(/databases/$(database)/documents/familyLinks/$(request.auth.uid)) && request.resource.data.parentUid == get(/databases/$(database)/documents/familyLinks/$(request.auth.uid)).data.parentUid && request.resource.data.captureType == 'child_consented_one_time_media_projection';
   allow read: if signedIn() && (resource.data.childUid == request.auth.uid || resource.data.parentUid == request.auth.uid);
   allow update,delete: if false;
  }
  match /usageReports/{childUid}{
   allow create,update: if signedIn() && request.auth.uid == childUid && request.resource.data.childUid == childUid && exists(/databases/$(database)/documents/familyLinks/$(childUid)) && get(/databases/$(database)/documents/familyLinks/$(childUid)).data.parentUid == request.resource.data.parentUid;
   allow read: if signedIn() && (request.auth.uid == childUid || (exists(/databases/$(database)/documents/familyLinks/$(childUid)) && get(/databases/$(database)/documents/familyLinks/$(childUid)).data.parentUid == request.auth.uid));
   allow delete: if false;
  }
  match /geofences/{fenceId}{
   allow create: if signedIn() && request.resource.data.parentUid == request.auth.uid && request.resource.data.active == true && request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90 && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180 && request.resource.data.radiusMeters is number && request.resource.data.radiusMeters >= 25 && request.resource.data.radiusMeters <= 100000 && exists(/databases/$(database)/documents/familyLinks/$(request.resource.data.childUid)) && get(/databases/$(database)/documents/familyLinks/$(request.resource.data.childUid)).data.parentUid == request.auth.uid;
   allow read: if signedIn() && (resource.data.parentUid == request.auth.uid || resource.data.childUid == request.auth.uid);
   allow update,delete: if signedIn() && resource.data.parentUid == request.auth.uid;
  }
  match /geofenceEvents/{eventId}{
   allow create: if signedIn() && request.resource.data.childUid == request.auth.uid && exists(/databases/$(database)/documents/familyLinks/$(request.auth.uid)) && get(/databases/$(database)/documents/familyLinks/$(request.auth.uid)).data.parentUid == request.resource.data.parentUid;
   allow read: if signedIn() && (resource.data.childUid == request.auth.uid || resource.data.parentUid == request.auth.uid);
   allow update,delete: if false;
  }
  // WebRTC session signalling foundation. No media is captured or streamed by these rules.
  // Parent requests a session; Child must explicitly approve before any capture may begin.
  // WebRTC signalling only. A Child must approve before capture/streaming starts.
  match /screenSessions/{sessionId}{
   allow create: if signedIn()
     && request.resource.data.parentUid == request.auth.uid
     && request.resource.data.childUid is string
     && request.resource.data.status == 'requested'
     && request.resource.data.offer is map
     && request.resource.data.offer.type == 'offer'
     && request.resource.data.offer.sdp is string
     && request.resource.data.offer.sdp.size() <= 65536
     && request.resource.data.keys().hasOnly(['parentUid','childUid','status','createdAt','offer'])
     && exists(/databases/$(database)/documents/familyLinks/$(request.resource.data.childUid))
     && get(/databases/$(database)/documents/familyLinks/$(request.resource.data.childUid)).data.parentUid == request.auth.uid;
   allow read: if signedIn()
     && (resource.data.parentUid == request.auth.uid || resource.data.childUid == request.auth.uid);
   allow update: if signedIn()
     && request.resource.data.parentUid == resource.data.parentUid
     && request.resource.data.childUid == resource.data.childUid
     && request.resource.data.createdAt == resource.data.createdAt
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','answer','updatedAt'])
     && (
       (resource.data.parentUid == request.auth.uid
         && request.resource.data.status in ['ended','cancelled'])
       || (resource.data.childUid == request.auth.uid
         && resource.data.status == 'requested'
         && ((request.resource.data.status == 'approved'
              && request.resource.data.answer is map
              && request.resource.data.answer.type == 'answer'
              && request.resource.data.answer.sdp is string
              && request.resource.data.answer.sdp.size() <= 65536)
             || (request.resource.data.status == 'denied' && !('answer' in request.resource.data)))
       || (resource.data.childUid == request.auth.uid
         && resource.data.status == 'approved'
         && request.resource.data.status == 'ended')
     );
   allow delete: if false;
   match /candidates/{candidateId}{
    allow create: if signedIn()
      && request.resource.data.senderUid == request.auth.uid
      && request.resource.data.candidate is string
      && request.resource.data.candidate.size() <= 8192
      && request.resource.data.keys().hasOnly(['senderUid','candidate','createdAt'])
      && ((get(/databases/$(database)/documents/screenSessions/$(sessionId)).data.parentUid == request.auth.uid
            && get(/databases/$(database)/documents/screenSessions/$(sessionId)).data.status in ['requested','approved'])
          || (get(/databases/$(database)/documents/screenSessions/$(sessionId)).data.childUid == request.auth.uid
            && get(/databases/$(database)/documents/screenSessions/$(sessionId)).data.status == 'approved'));
    allow read: if signedIn()
      && (get(/databases/$(database)/documents/screenSessions/$(sessionId)).data.parentUid == request.auth.uid
          || get(/databases/$(database)/documents/screenSessions/$(sessionId)).data.childUid == request.auth.uid);
    allow update,delete: if false;
   }
  }
  match /parentProfiles/{parentUid}{
   allow create,update: if signedIn() && request.auth.uid == parentUid
     && request.resource.data.keys().hasOnly(['fcmToken','updatedAt'])
     && (!('fcmToken' in request.resource.data) || (request.resource.data.fcmToken is string && request.resource.data.fcmToken.size() > 20));
   allow read: if signedIn() && request.auth.uid == parentUid;
   allow delete: if false;
  }

 }
}